# Copy to .env and fill in; docker compose reads it. Never commit .env (it is in .gitignore).

# The Apex Classic's web sign-in (the user and password of its own web pages). Its address is in config/site.yaml.
REEF_APEX_USER=admin
REEF_APEX_PASSWORD=

# The address people and MCP clients use to reach the console. The MCP endpoint answers only to this host name (and
# to REEF_EXTRA_HOSTS, comma-separated), a guard against DNS rebinding.
REEF_PUBLIC_URL=http://localhost:8001/reef
REEF_EXTRA_HOSTS=

# Sign-in: basic (users in config/users.txt, see README), none (no sign-in: a trusted LAN only), or forward (another
# service holds the sign-in: docs/configuration.md).
REEF_AUTH=basic

# The port the pages are published on.
REEF_PORT=8001
